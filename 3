# Enter your code here. Read input from STDIN. Print output to STDOUT
from collections import defaultdict
n_m =input().split()
n=int(n_m[0])
m=int(n_m[1])
d=defaultdict(list)
for i in range(1, n + 1):
    word_a=input()
    d[word_a].append(str(i)) 
for _ in range(m):
    word_b=input()
    if word_b in d:
        print(" ".join(d[word_b]))
    else:
        print("-1")
